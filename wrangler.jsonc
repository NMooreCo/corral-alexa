{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is for `pnpm dev` on this machine. Deploys always name an environment:
  // `pnpm ship` (production, linked to a real Corral) or `pnpm ship:demo` (the sample household).
  "name": "corral-alexa-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public sends calls to Corral over the public internet, even from a Worker in the same zone.
  // It also keeps every fetch off the LAN, so `pnpm dev:lan` (the local greenhouse connector) runs without it, on this machine only.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "vars": {
    // "sample" answers from the built-in sample household; "corral" answers from a real Corral after account linking.
    "BACKEND": "sample",
    "CORRAL_URL": "https://corral.narralogy.ai",
    // The simulated Echo Show's model: a model on Bedrock (the BEDROCK_API_KEY secret; an "anthropic." id speaks
    // the Messages API, any other, like "openai.gpt-5.6-terra", the Responses API) or the Claude API
    // (ANTHROPIC_API_KEY, and ANTHROPIC_BASE_URL for a gateway that speaks it). MODEL_PROVIDER picks one;
    // unset, whichever has a key, Bedrock first. Locally, MODEL_MOCK=true answers with a practice model.
    "BEDROCK_REGION": "us-west-2",
    "BEDROCK_MODEL": "anthropic.claude-opus-5-5"
  },
  // Account linking's grants and clients, simulated locally by `wrangler dev`.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // At most 20 simulator model calls and 30 spoken answers a minute per visitor.
  "ratelimits": [
    { "name": "MODEL_LIMIT", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
    { "name": "VOICE_LIMIT", "namespace_id": "4203", "simple": { "limit": 30, "period": 60 } }
  ],
  // The shared sample household (sample mode): one Durable Object per household, so every device sees the same one,
  // kept in the object's own SQLite database. Named environments don't inherit this binding.
  "durable_objects": { "bindings": [{ "name": "SAMPLE_HOUSEHOLDS", "class_name": "SampleHouseholdObject" }] },
  // Declares the class and its SQLite storage: the declarative form that replaces the "migrations" array.
  // Named environments do inherit this, so production empties it.
  "exports": { "SampleHouseholdObject": { "type": "durable-object", "storage": "sqlite" } },
  "dev": { "port": 8795 },
  "env": {
    // Linked to Corral: account linking in front, every call made with the person's own Corral token.
    "production": {
      "name": "corral-alexa",
      "routes": [{ "pattern": "alexa.corral.narralogy.ai", "custom_domain": true }],
      "vars": {
        "BACKEND": "corral",
        "CORRAL_URL": "https://corral.narralogy.ai",
        "PUBLIC_URL": "https://alexa.corral.narralogy.ai"
      },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "2873e0d58fb5483183130ef91bd17ba8" }],
      // No Durable Object: the linked bridge has no sample household. The binding isn't inherited; exports would be.
      "durable_objects": { "bindings": [] },
      "exports": {},
      "observability": { "enabled": true }
    },
    // The sample household, open to anyone, with /preview and the simulated Echo Show at /echo: for judges and demos, never any real household's data.
    "demo": {
      "name": "corral-alexa-demo",
      "routes": [{ "pattern": "alexa-demo.corral.narralogy.ai", "custom_domain": true }],
      // No CORRAL_URL and no KV on purpose (Wrangler notes that they aren't inherited): nothing here can reach a real household.
      "vars": { "BACKEND": "sample", "MODEL_PROVIDER": "anthropic", "BEDROCK_REGION": "us-west-2", "BEDROCK_MODEL": "anthropic.claude-opus-5-5" },
      "kv_namespaces": [],
      "ratelimits": [
        { "name": "MODEL_LIMIT", "namespace_id": "4202", "simple": { "limit": 20, "period": 60 } },
        { "name": "VOICE_LIMIT", "namespace_id": "4204", "simple": { "limit": 30, "period": 60 } }
      ],
      // One shared household for every visitor and device, kept through restarts (the first deploy creates the class).
      "durable_objects": { "bindings": [{ "name": "SAMPLE_HOUSEHOLDS", "class_name": "SampleHouseholdObject" }] },
      "exports": { "SampleHouseholdObject": { "type": "durable-object", "storage": "sqlite" } },
      "observability": { "enabled": true }
    }
  }
}
